@@ -1325,6 +1335,21 @@
 			 && enough(conf, devnum))
 		mbio->bi_opf |= MD_FAILFAST;
 	mbio->bi_private = r10_bio;
+#ifdef MS_P2P_ROUTE_FENCE_KERNEL
