#!/usr/bin/env bash
#
# gds-make-kit — assemble the scp-able campaign kit for the L40S window.
# Builds THREE DKMS tarballs (gdsM = origin/meshstor-main shipping
# composition, the featured/default install; gds1 = master + p2pdma pinned
# @0fb37cf5, pre-fix, P7e A/B contrast only; gds0 = verbatim master
# baseline) plus kit-manifest.tsv (per-variant srcversion identity for
# ms_mod/raid1_ms/raid10_ms), and stages tools, selftests, the injector,
# udev rule, runbook and installer (installs gdsM + /usr/sbin/msadm).
#
# Usage: gds-make-kit <version> [--skip-tarballs]
set -eu
VER=${1:?usage: gds-make-kit <version> [--skip-tarballs]}
SKIP_TB=${2:-}
ROOT=$(cd "$(dirname "$0")/.." && pwd)
KIT="$ROOT/build/gds-kit-$VER"
MDADM_BIN="${MDADM_BIN:-/home/${SUDO_USER:-$USER}/mdadm/mdadm}"

# Variant identity pins (every SHA must be origin-reachable — §1 rule of the
# 2026-07-03 stage-1 validation design; local rewrite leftovers don't ship).
PIN_GDS1=cefe89a2          # p2pdma "clear P2P advertise on non-P2P hot-add": the
                           # last pre-fix md commit (gate + hot-add-clear, BEFORE
                           # the stage-1 fail-the-write arm). Rebasing origin/p2pdma
                           # orphans this SHA — the refusal below prints the new one.
if [ "$SKIP_TB" = --skip-tarballs ]; then
	# The manifest must describe the tarballs ACTUALLY built earlier — never
	# freshly recomputed refs (origin may have moved since that build). The
	# tarball build persists its SHAs; refuse to guess without them.
	[ -e "$ROOT/build/gds-kit-shas.env" ] \
		|| { echo "--skip-tarballs: build/gds-kit-shas.env missing — SHAs were not persisted at tarball-build time; rerun without --skip-tarballs" >&2; exit 1; }
	. "$ROOT/build/gds-kit-shas.env"
else
	git -C "$ROOT" fetch origin p2pdma meshstor-main master
	git -C "$ROOT" merge-base --is-ancestor "$PIN_GDS1" origin/p2pdma || {
		# origin/p2pdma was rebased and orphaned the pin. The correct commit
		# is the parent of the earliest stage-1 arm ("fail P2P writes loud");
		# surface it so re-pinning is a 10-second verify-and-bump, not a dig.
		cand=$(git -C "$ROOT" rev-list --reverse --grep='fail P2P writes loud' \
			origin/master..origin/p2pdma 2>/dev/null | head -1)
		[ -n "$cand" ] && cand=$(git -C "$ROOT" rev-parse --short "$cand^" 2>/dev/null)
		echo "gds1 pin $PIN_GDS1 is not reachable from origin/p2pdma — refusing." >&2
		echo "  origin/p2pdma was likely rebased; likely new pre-fix pin: ${cand:-<none found>}" >&2
		[ -n "$cand" ] && echo "  verify: git show -s --format='%s' $cand  (want: clear P2P advertise on non-P2P hot-add)" >&2
		exit 1
	}
	GDS1_SHA=$(git -C "$ROOT" rev-parse "$PIN_GDS1")
	GDSM_SHA=$(git -C "$ROOT" rev-parse origin/meshstor-main)
	# gds0/gds1 base = rebuild-main's OWN torvalds mirror (build/torvalds-linux.git),
	# NOT this repo's origin/master: rebuild-main builds from that mirror and
	# refetches it when run without --no-fetch. Pin by building BOTH gds0 and gds1
	# with --no-fetch and recording the mirror's actual SHA — the tree actually
	# built. (This SHA names the mirror's build input; it is the one recorded
	# value exempt from the §1 origin-reachability rule, which governs pins in
	# THIS repo's history.)
	GDS0_SHA=$(git -C "$ROOT/build/torvalds-linux.git" rev-parse master)
	# Persist for --skip-tarballs reruns: the manifest step below reuses
	# EXACTLY the SHAs the tarballs were built from.
	printf 'GDS0_SHA=%s\nGDS1_SHA=%s\nGDSM_SHA=%s\n' "$GDS0_SHA" "$GDS1_SHA" "$GDSM_SHA" \
		> "$ROOT/build/gds-kit-shas.env"
fi

if [ "$SKIP_TB" != --skip-tarballs ]; then
	echo "== baseline tree (verbatim master @ $GDS0_SHA) =="
	"$ROOT/bin/rebuild-main" --no-fetch
	KERNEL_TREE="$ROOT/build/linux-meshstor-rebuilt" "$ROOT/bin/build-tarball" "$VER.gds0"
	echo "== gds1 tree (master + p2pdma pinned @ $GDS1_SHA, pre-fix A/B contrast) =="
	# Pin mechanism: a throwaway local branch at the pinned SHA; rebuild-main
	# sources branches local-first by NAME, so this never disturbs the local
	# p2pdma branch and never floats with its head.
	git -C "$ROOT" branch -f gds-kit-pin-gds1 "$GDS1_SHA"
	"$ROOT/bin/rebuild-main" --no-fetch gds-kit-pin-gds1
	git -C "$ROOT" branch -D gds-kit-pin-gds1
	KERNEL_TREE="$ROOT/build/linux-meshstor-rebuilt" "$ROOT/bin/build-tarball" "$VER.gds1"
	echo "== gdsM tree (origin/meshstor-main @ $GDSM_SHA — the shipping composition) =="
	# Composition is rebuild-meshstor-main's job; the kit consumes the pushed
	# result as-is via a scratch worktree (no cherry-picking here).
	GDSM_WT="$ROOT/build/gdsM-src-worktree"
	git -C "$ROOT" worktree remove --force "$GDSM_WT" 2>/dev/null || true
	git -C "$ROOT" worktree add --detach "$GDSM_WT" "$GDSM_SHA"
	KERNEL_TREE="$GDSM_WT" "$ROOT/bin/build-tarball" "$VER.gdsM"
	git -C "$ROOT" worktree remove --force "$GDSM_WT"
	echo "== nvme-rdma P2PDMA override =="
	"$ROOT/bin/build-nvme-tarball" "$VER"
fi
for t in gds0 gds1 gdsM; do
	ls "$ROOT/build/meshstor-ms-$VER.$t.dkms.tar.gz" >/dev/null \
		|| { echo "missing tarball for $t — run without --skip-tarballs" >&2; exit 1; }
done
ls "$ROOT/build/meshstor-nvme-rdma-$VER.dkms.tar.gz" >/dev/null \
	|| { echo "missing nvme-rdma tarball for $VER — run without --skip-tarballs" >&2; exit 1; }

rm -rf "$KIT"; mkdir -p "$KIT"/{bin,tarballs,udev,docs}
cp "$ROOT/build/meshstor-ms-$VER".gds{0,1,M}.dkms.tar.gz "$KIT/tarballs/"
cp "$ROOT/build/meshstor-nvme-rdma-$VER.dkms.tar.gz" "$KIT/tarballs/"
for b in gds-campaign ms-queue-features gds-p2p-witness gds-kit-manifest probe-cufile-recognition perf-make-test-partitions; do
	cp "$ROOT/bin/$b" "$KIT/bin/"
done

# kit-manifest.tsv: variant<TAB>ref+sha<TAB>tarball<TAB>srcversions.
# build-tarball emits SOURCE only, so do a throwaway local kbuild per
# variant against the running kernel to read the srcversions the box will
# see after dkms install (compat patches + rename applied at tarball time
# => on-box rebuilds are source-identical and srcversion-stable). The
# stage-1 delta lives entirely in raid1*/raid10* sources — gds1 and gdsM
# may legitimately share an identical ms_mod srcversion; ALWAYS record all
# three modules so the identity gate can police the personality under test.
manifest_row() {  # VARIANT REF TARBALL
	local variant=$1 ref=$2 tb=$3 tmp d sv_ms sv_r1 sv_r10
	tmp=$(mktemp -d)
	tar xzf "$ROOT/build/$tb" -C "$tmp"
	d=$(ls -d "$tmp"/meshstor-ms-*)
	make -C "$d" >/dev/null
	sv_ms=$(modinfo -F srcversion "$d/ms_mod.ko")
	sv_r1=$(modinfo -F srcversion "$d/raid1_ms.ko")
	sv_r10=$(modinfo -F srcversion "$d/raid10_ms.ko")
	[ -n "$sv_ms" ] && [ -n "$sv_r1" ] && [ -n "$sv_r10" ] \
		|| { echo "manifest: empty srcversion for $variant" >&2; exit 1; }
	printf '%s\t%s\t%s\tms_mod=%s raid1_ms=%s raid10_ms=%s\n' \
		"$variant" "$ref" "$tb" "$sv_ms" "$sv_r1" "$sv_r10" >> "$KIT/kit-manifest.tsv"
	rm -rf "$tmp"
}
: > "$KIT/kit-manifest.tsv"
# 'master@' in the gds0/gds1 refs = the torvalds mirror's SHA actually built
# ($GDS0_SHA from build/torvalds-linux.git), not this repo's origin/master.
manifest_row gds0 "master@$GDS0_SHA" "meshstor-ms-$VER.gds0.dkms.tar.gz"
manifest_row gds1 "master@$GDS0_SHA+p2pdma@$GDS1_SHA" "meshstor-ms-$VER.gds1.dkms.tar.gz"
manifest_row gdsM "origin/meshstor-main@$GDSM_SHA" "meshstor-ms-$VER.gdsM.dkms.tar.gz"
echo "== kit-manifest.tsv =="; column -t -s$'\t' "$KIT/kit-manifest.tsv" || cat "$KIT/kit-manifest.tsv"
mkdir -p "$KIT/selftests"
# Repo dir is p2pdma-vm (renamed to avoid p2pdma-branch cherry-pick collisions);
# the kit keeps the flat `selftests/p2pdma` name its layout + gds-campaign expect.
cp -r "$ROOT/tools/testing/selftests/md/p2pdma-vm" "$KIT/selftests/p2pdma"
cp -r "$ROOT/dkms/inval-inject" "$KIT/inval-inject"
cp "$ROOT/dkms/udev/63-ms-raid-arrays.rules" "$KIT/udev/"
cp "$ROOT/docs/gds-l40s-runbook.md" "$KIT/docs/"
if [ -x "$MDADM_BIN" ]; then cp "$MDADM_BIN" "$KIT/bin/mdadm-ms"
else echo "WARN: patched mdadm not at $MDADM_BIN — kit ships without it (set MDADM= on the box)"; fi

cat > "$KIT/install.sh" <<'EOF'
#!/usr/bin/env bash
# Run as root on the target box. Installs the FEATURED package (gdsM — the
# meshstor-main shipping composition, stage-1 fail-the-write included) and
# prints the environment to use. gds1 (pre-fix) and gds0 (upstream baseline)
# stay in tarballs/ for the campaign's A/B phases only.
# Requires: dkms, kernel headers, bpftrace, nvme-cli, fio.
set -eu
HERE=$(cd "$(dirname "$0")" && pwd)
# Manifest-driven selection (fallback glob for a manifest-less kit).
# NB set -eu is live: a failing $() inside an assignment would abort the
# installer, so the parser call carries its own || true.
TB=""
if [ -e "$HERE/kit-manifest.tsv" ] && [ -x "$HERE/bin/gds-kit-manifest" ]; then
	MTB=$("$HERE/bin/gds-kit-manifest" "$HERE/kit-manifest.tsv" gdsM tarball || true)
	[ -n "$MTB" ] && TB="$HERE/tarballs/$MTB"
	cp -f "$HERE/kit-manifest.tsv" "$HERE/tarballs/"   # identity travels with the tarballs
fi
[ -n "$TB" ] && [ -f "$TB" ] || TB=$(ls "$HERE"/tarballs/*gdsM*.dkms.tar.gz 2>/dev/null | head -1)
[ -n "$TB" ] && [ -f "$TB" ] \
	|| { echo "install.sh: no gdsM tarball in $HERE/tarballs" >&2; exit 1; }
TMP=$(mktemp -d); tar xzf "$TB" -C "$TMP"
VER=$(ls "$TMP" | sed -n 's/^meshstor-ms-//p' | head -1)
rm -rf "/usr/src/meshstor-ms-$VER"; cp -r "$TMP/meshstor-ms-$VER" /usr/src/; rm -rf "$TMP"
dkms add "meshstor-ms/$VER" || true
# same-version re-run: already-installed = success (dkms 3.x exits nonzero)
dkms status "meshstor-ms/$VER" -k "$(uname -r)" 2>/dev/null | grep -q ': installed' \
	|| dkms install "meshstor-ms/$VER"
modprobe ms_mod && modprobe raid1_ms && modprobe raid10_ms
# nvme-rdma P2PDMA override (best-effort; BUILD_EXCLUSIVE_KERNEL refuses
# non-target kernels -- campaign then runs on the stock driver and P0
# records that). set -eu is active: every fallible step below sits inside
# an if-condition so NOTHING in this block can abort the installer.
NTB=$(ls "$HERE"/tarballs/meshstor-nvme-rdma-*.dkms.tar.gz 2>/dev/null | head -1)
if [ -n "$NTB" ]; then
if NTMP=$(mktemp -d) && tar xzf "$NTB" -C "$NTMP" \
   && NVER=$(ls "$NTMP" | sed -n 's/^meshstor-nvme-rdma-//p' | head -1) \
   && [ -n "$NVER" ] \
   && rm -rf "/usr/src/meshstor-nvme-rdma-$NVER" \
   && cp -r "$NTMP/meshstor-nvme-rdma-$NVER" /usr/src/; then
	dkms add "meshstor-nvme-rdma/$NVER" >/dev/null 2>&1 || true
	# dkms 3.x exits nonzero ("already installed") on a re-run of the
	# same module/version/kernel tuple -- and the runbook says to re-run
	# install.sh. Treat already-installed as success. NB: re-shipping
	# CHANGED override source under the same version keeps the old
	# build -- bump the package version instead.
	if dkms status "meshstor-nvme-rdma/$NVER" -k "$(uname -r)" 2>/dev/null | grep -q ': installed' \
	   || dkms install "meshstor-nvme-rdma/$NVER"; then
		# reload so the override takes effect if the stock module was
		# already loaded; -r fails if a fabric is connected
		modprobe -r nvme_rdma 2>/dev/null || true
		modprobe nvme_rdma 2>/dev/null || true
		# "active" must mean LOADED (depmod already prefers /updates
		# right after dkms install, so modinfo alone would lie).
		# initstate = loadedness; srcversion equality = build identity.
		ondisk=$(modinfo -F srcversion nvme_rdma 2>/dev/null || true)
		loaded=$(cat /sys/module/nvme_rdma/srcversion 2>/dev/null || true)
		if [ ! -e /sys/module/nvme_rdma/initstate ] \
		   && modinfo -F filename nvme_rdma 2>/dev/null | grep -q /updates/; then
			echo "OK: nvme-rdma override installed (not loaded yet; next modprobe loads it)"
		elif [ "$loaded" = "$ondisk" ] \
		   && modinfo -F filename nvme_rdma 2>/dev/null | grep -q /updates/; then
			echo "OK: nvme-rdma P2PDMA override active (loaded)"
		else
			echo "WARNING: override installed but a DIFFERENT nvme-rdma build is still loaded" >&2
			echo "         (stock, or an older override; reload blocked by an active fabric?)" >&2
			echo "         disconnect, then: modprobe -r nvme_rdma && modprobe nvme_rdma" >&2
		fi
	else
		echo "WARNING: nvme-rdma override build refused/failed (kernel outside target families?) -- campaign runs with STOCK nvme-rdma (no P2P on rdma legs)" >&2
	fi
else
	echo "WARNING: nvme-rdma tarball unpack failed -- skipping override; campaign runs with STOCK nvme-rdma" >&2
fi
rm -rf "${NTMP:-}" 2>/dev/null || true
fi
install -m0644 "$HERE/udev/63-ms-raid-arrays.rules" /usr/lib/udev/rules.d/
udevadm control --reload
# /usr/sbin/msadm: the udev rule's IMPORT{program} hard-depends on it and
# every P7 subtest is downstream of that rule (was the standing kit gap).
if [ -x "$HERE/bin/mdadm-ms" ]; then
	install -m0755 "$HERE/bin/mdadm-ms" /usr/sbin/msadm
	echo "OK: /usr/sbin/msadm installed (udev RAID classification)"
else
	echo "WARNING: kit has no bin/mdadm-ms — install /usr/sbin/msadm manually (cuFile classification needs it)" >&2
fi
grep -q 'Personalities' /proc/msstat && echo "OK: /proc/msstat live"
cat <<ENV
Run the campaign:
  sudo MDADM=$HERE/bin/mdadm-ms GDS_KIT_DIR=$HERE $HERE/bin/gds-campaign --results /root/gds-results
ENV
EOF
chmod +x "$KIT/install.sh" "$KIT"/bin/*

tar czf "$ROOT/build/gds-kit-$VER.tar.gz" -C "$ROOT/build" "gds-kit-$VER"
echo "Built: $ROOT/build/gds-kit-$VER.tar.gz"
