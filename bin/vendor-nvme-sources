#!/usr/bin/env bash
# vendor-nvme-sources — populate/refresh dkms-nvme/vendor/ with each target
# kernel's private nvme host sources {rdma.c, nvme.h, fabrics.h}.
#
# Variants and default sources ("latest" = newest release tag / SRPM):
#   u2604   Ubuntu 26.04 (7.0) AND Ubuntu 24.04 HWE 7.0
#           Launchpad resolute linux git, Ubuntu-7.0.0-* tag
#   rhel10  Rocky/RHEL 10 (6.12)  latest Rocky 10 BaseOS kernel SRPM
#
# There is deliberately NO noble (24.04) variant: noble's HWE-7.0
# {rdma.c,nvme.h,fabrics.h} are byte-identical to resolute's, so a
# noble-7.0 box builds the u2604 variant (dkms-nvme/Makefile.in maps
# 7.0.*-generic there). That mapping is sound ONLY while the byte-identity
# holds, so this script FAILS (exit 4) the moment noble's newest HWE
# family diverges from resolute — the signal to vendor a real noble
# variant. It also fails if noble's newest HWE family is no longer
# resolute's family at all (e.g. noble rolls to 7.1 before resolute moves).
#
# Sunset probe: for every fetched IN-TREE rdma.c this script reports when
# the distro kernel itself gained P2PDMA support (upstream 23528aa3320a,
# v7.1) — at that point the variant (or, for noble, the whole package on
# that family) can retire.
#
# Files are vendored BYTE-IDENTICAL to the distro source. The p2pdma
# backport lives in dkms-nvme/patches/<variant>/ and is applied at
# tarball-assembly time (bin/build-nvme-tarball), never here.
#
# Exit: 0 = vendor tree unchanged, 3 = files were (re)written — re-verify
# that dkms-nvme/patches/ still applies at --fuzz=0 before committing,
# 4 = the noble mapping guard tripped (family moved or sources diverged).
# Network-using by design; run manually when a target moves, never from
# the build pipeline.
#
# Usage: bin/vendor-nvme-sources [--u2604 TAG] [--rhel10 NVR] [--noble TAG]
#                                [--skip-rhel10]
set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
VENDOR="$REPO_ROOT/dkms-nvme/vendor"
FILES=(rdma.c nvme.h fabrics.h)

NOBLE_GIT="https://git.launchpad.net/~ubuntu-kernel/ubuntu/+source/linux/+git/noble"
RESOLUTE_GIT="https://git.launchpad.net/~ubuntu-kernel/ubuntu/+source/linux/+git/resolute"
ROCKY_SRC="https://dl.rockylinux.org/pub/rocky/10/BaseOS/source/tree/Packages/k"

U2604_TAG= RHEL10_NVR= NOBLE_TAG= SKIP_RHEL10=
while (($#)); do
    case "$1" in
        --u2604)  U2604_TAG="${2:?}";  shift 2 ;;
        --rhel10) RHEL10_NVR="${2:?}"; shift 2 ;;
        --noble)  NOBLE_TAG="${2:?}";  shift 2 ;;
        --skip-rhel10) SKIP_RHEL10=1;  shift ;;
        *) echo "usage: $0 [--u2604 TAG] [--rhel10 NVR] [--noble TAG] [--skip-rhel10]" >&2; exit 2 ;;
    esac
done

for t in curl git rpm2cpio cpio xz tar; do
    command -v "$t" >/dev/null \
        || { echo "error: required tool '$t' not installed" >&2; exit 1; }
done

mkdir -p "$REPO_ROOT/build"
TMP="$(mktemp -d "$REPO_ROOT/build/vendor-nvme.XXXXXX")"
trap 'rm -rf "$TMP"' EXIT

latest_tag() { # $1=repo url  $2=tag glob -> newest matching tag name
    git ls-remote --tags "$1" "$2" \
        | awk -F/ '{print $NF}' | grep -v '\^{}$' | sort -V | tail -1
}

write_provenance() { # $1=variant  $2=source line  $3=ref line  $4=reverify line
    local dir="$VENDOR/$1"
    {
        echo "# Provenance of dkms-nvme/vendor/$1 — written by bin/vendor-nvme-sources"
        echo "# Vendored: $(date -u +%Y-%m-%dT%H:%M:%SZ)"
        echo "source: $2"
        echo "ref: $3"
        echo "re-verify: $4"
        echo "# sha256 of vendored files:"
        (cd "$dir" && sha256sum "${FILES[@]}")
    } > "$dir/PROVENANCE"
}

files_changed() { # $1=variant -> true if any of its 3 vendored files differ from the committed tree
    git -C "$REPO_ROOT" status --porcelain -- "${FILES[@]/#/dkms-nvme/vendor/$1/}" | grep -q .
}

fetch_launchpad() { # $1=variant  $2=repo url  $3=tag  $4=pin flag name
    local variant="$1" repo="$2" tag="$3" flag="$4" f
    mkdir -p "$VENDOR/$variant"
    for f in "${FILES[@]}"; do
        curl -fsS "$repo/plain/drivers/nvme/host/$f?h=$tag" \
            -o "$VENDOR/$variant/$f"
    done
    if [[ ! -f "$VENDOR/$variant/PROVENANCE" ]] || files_changed "$variant"; then
        write_provenance "$variant" "$repo" "$tag" \
            "bin/vendor-nvme-sources $flag $tag && git diff --exit-code dkms-nvme/vendor/$variant"
    fi
    echo "vendored $variant  <-  $tag"
}

fetch_rocky() { # $1=NVR like 6.12.0-211.26.1.el10_2, or empty = latest
    local nvr="$1" srpm f
    if [[ -z "$nvr" ]]; then
        srpm="$(curl -fsS "$ROCKY_SRC/" \
            | grep -oE 'kernel-6\.12\.0-[0-9.]+\.el10[_0-9]*\.src\.rpm' \
            | sort -uV | tail -1)"
        [[ -n "$srpm" ]] || { echo "error: no kernel SRPM index at $ROCKY_SRC" >&2; exit 1; }
    else
        srpm="kernel-$nvr.src.rpm"
    fi
    nvr="${srpm#kernel-}"; nvr="${nvr%.src.rpm}"
    mkdir -p "$VENDOR/rhel10"
    echo "downloading $srpm (large; a few hundred MB)"
    curl -fS -o "$TMP/$srpm" "$ROCKY_SRC/$srpm"
    (cd "$TMP" && rpm2cpio "$srpm" | cpio -id --quiet 'linux-*.tar.xz')
    tar -xJf "$TMP"/linux-*.tar.xz -C "$TMP" --wildcards \
        'linux-*/drivers/nvme/host/rdma.c' \
        'linux-*/drivers/nvme/host/nvme.h' \
        'linux-*/drivers/nvme/host/fabrics.h'
    for f in "${FILES[@]}"; do
        cp "$TMP"/linux-*/drivers/nvme/host/"$f" "$VENDOR/rhel10/$f"
    done
    if [[ ! -f "$VENDOR/rhel10/PROVENANCE" ]] || files_changed rhel10; then
        write_provenance rhel10 "$ROCKY_SRC/$srpm" "$nvr" \
            "bin/vendor-nvme-sources --rhel10 $nvr && git diff --exit-code dkms-nvme/vendor/rhel10"
    fi
}

sunset_probe() { # $1=label  $2=path to an IN-TREE (pre-backport) rdma.c
    if grep -q 'p2pdma' "$2"; then
        echo "SUNSET: $1 in-tree nvme-rdma now references p2pdma — the distro"
        echo "        kernel gained native P2P support (upstream 23528aa3320a);"
        echo "        this variant/family can likely retire. Verify and prune."
    fi
}

# The noble mapping guard (see header): newest noble HWE family must still
# be resolute's family, and its three files must be byte-identical to the
# freshly vendored u2604 set. Either failure exits 4.
noble_hwe_check() {
    local tag="$NOBLE_TAG" fam res_fam f differs=
    res_fam="$(sed -E 's/^Ubuntu-([0-9]+\.[0-9]+)\..*/\1/' <<<"$U2604_TAG")"
    if [[ -z "$tag" ]]; then
        fam="$(git ls-remote --tags "$NOBLE_GIT" 'Ubuntu-hwe-*' \
            | awk -F/ '{print $NF}' | grep -v '\^{}$' \
            | sed -nE 's/^Ubuntu-hwe-([0-9]+\.[0-9]+)-.*/\1/p' | sort -uV | tail -1)"
        [[ -n "$fam" ]] || { echo "error: cannot list noble HWE families" >&2; exit 1; }
        tag="$(latest_tag "$NOBLE_GIT" "Ubuntu-hwe-$fam-*")"
    else
        fam="$(sed -nE 's/^Ubuntu-hwe-([0-9]+\.[0-9]+)-.*/\1/p' <<<"$tag")"
    fi
    if [[ "$fam" != "$res_fam" ]]; then
        echo "error: noble's newest HWE family is $fam, but the vendored u2604 family is $res_fam." >&2
        echo "       The '7.0.*-generic -> u2604' mapping no longer covers noble's newest" >&2
        echo "       kernel: vendor a real noble variant or retire the family (README)." >&2
        exit 4
    fi
    mkdir -p "$TMP/noble"
    for f in "${FILES[@]}"; do
        curl -fsS "$NOBLE_GIT/plain/drivers/nvme/host/$f?h=$tag" -o "$TMP/noble/$f"
        cmp -s "$TMP/noble/$f" "$VENDOR/u2604/$f" || differs+=" $f"
    done
    if [[ -n "$differs" ]]; then
        echo "error: noble $tag DIVERGES from vendored u2604 in:$differs" >&2
        echo "       The byte-identity that lets noble-7.0 boxes build the u2604 variant" >&2
        echo "       is broken — vendor a real noble variant now (dkms-nvme/README.md)." >&2
        exit 4
    fi
    echo "noble ok  <-  $tag (byte-identical to u2604: ${FILES[*]})"
    sunset_probe "noble ($fam HWE)" "$TMP/noble/rdma.c"
}

[[ -n "$U2604_TAG" ]] || U2604_TAG="$(latest_tag "$RESOLUTE_GIT" 'Ubuntu-7.0.0-*')"
[[ -n "$U2604_TAG" ]] \
    || { echo "error: could not resolve a Launchpad tag" >&2; exit 1; }

fetch_launchpad u2604 "$RESOLUTE_GIT" "$U2604_TAG" --u2604
sunset_probe "u2604 (resolute)" "$VENDOR/u2604/rdma.c"
noble_hwe_check
if [[ -z "$SKIP_RHEL10" ]]; then
    fetch_rocky "$RHEL10_NVR"
    sunset_probe "rhel10" "$VENDOR/rhel10/rdma.c"
else
    echo "skipping rhel10 (--skip-rhel10)"
fi

if git -C "$REPO_ROOT" status --porcelain -- dkms-nvme/vendor | grep -q .; then
    echo
    echo "vendor tree CHANGED — verify dkms-nvme/patches/ still applies at"
    echo "--fuzz=0 (bin/build-nvme-tarball fails loudly if not), then commit."
    exit 3
fi
echo "vendor tree unchanged."
